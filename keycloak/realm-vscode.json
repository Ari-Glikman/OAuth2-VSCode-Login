{
  "realm": "vscode",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "iris:%Developer", "description": "Becomes the IRIS role %Developer" }
    ]
  },
  "users": [
    {
      "username": "dev1",
      "enabled": true,
      "email": "dev1@example.com",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "One",
      "credentials": [ { "type": "password", "value": "123", "temporary": false } ],
      "realmRoles": [ "iris:%Developer", "default-roles-vscode" ]
    }
  ],
  "clients": [
    {
      "clientId": "vscode-iris",
      "name": "VS Code (InterSystems Server Manager)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [ "vscode://intersystems-community.servermanager/oauth2-callback" ],
      "webOrigins": [],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "iris-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "http://localhost:52773/",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "iris-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "iris_roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
